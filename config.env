# ak-pi-zero-benchmarks — central config. Sourced by every script.
# Everything here is safe to commit (no secrets except the throwaway API pw,
# which only governs a lab box on a trusted LAN).

# --- target box ---
PI_USER=geraci
PI_IP=192.168.42.107
PI_HOST="${PI_USER}@${PI_IP}"
# Plain per-call ssh (no ControlMaster multiplexing — it proved flaky under the
# rapid-fire calls in reset_repo and silently dropped restart/rm commands).
PI_SSH_OPTS="-o ConnectTimeout=15 -o ServerAliveInterval=10 -o BatchMode=yes"

# --- TLS (self-signed server cert, committed under certs/) ---
AK_CERT="certs/ak-ca.crt"        # local CA (trust anchor) for pip --cert / cargo CAINFO
PI_STORAGE=/home/geraci/artifact-keeper/data/storage  # backend filesystem storage root
BASE_URL="https://${PI_IP}"      # nginx TLS front

# --- API auth ---
# The backend ships admin/admin locked; 01_setup_proxies.sh rotates it to the
# password below on first run and reuses it afterwards. Lab-grade only.
AK_ADMIN_USER=admin
AK_ADMIN_INITIAL_PW=admin
AK_ADMIN_PW=AkPiZero-bench-2026

# --- proxy repositories created by 01_setup_proxies.sh ---
PYPI_REPO=pypi-proxy
PYPI_UPSTREAM=https://pypi.org
CARGO_REPO=cargo-proxy

# --- client-facing URL templates (filled from backend route scheme) ---
# Overridden/confirmed in lib/common.sh helpers; kept here for visibility.
PYPI_INDEX_URL="${BASE_URL}/pypi/${PYPI_REPO}/simple/"
CARGO_SPARSE_URL="sparse+${BASE_URL}/cargo/${CARGO_REPO}/"
# cargo's split upstream: index host vs download host (crates.io layout)
CARGO_INDEX_UPSTREAM=https://index.crates.io
CARGO_DL_UPSTREAM=https://crates.io

# --- sampler ---
SAMPLE_INTERVAL=0.25             # seconds between resource samples on the Pi
PI_IFACE=wlan0                   # network interface for byte counters
PI_CLK_TCK=100                   # getconf CLK_TCK on the Pi (for CPU-seconds math)

# --- run settings ---
RESULTS_DIR="results"
